# Seguridad: solo se puede abrir index.php y los archivos de vista/ (css, js, imágenes).
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(controlador|modelo|bd|archivos)(/|$) - [F,L]
    RewriteRule ^vista/.*\.php$ - [F,L]
</IfModule>

# Tamaño máximo de los archivos que se suben (documentos escaneados y fotos): 100 MB
<IfModule mod_php.c>
    php_value upload_max_filesize 100M
    php_value post_max_size 105M
    php_value max_input_time 600
    php_value max_execution_time 600
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 100M
    php_value post_max_size 105M
    php_value max_input_time 600
    php_value max_execution_time 600
</IfModule>
